# ========================================================
# STUDIORA - Environment Variables Template
# Copy this file to .env (or configure in Render Dashboard)
# ========================================================

# AI Configuration (Required for live AI generation)
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Database Configuration (Defaults to internal SQLite database)
DATABASE_URL=sqlite:///./studiora.db

# Security & Authentication (Required for signing JWT tokens)
JWT_SECRET_KEY=studiora_production_jwt_secret_key_change_me_in_prod_2026

# CORS / Domain Configuration (Optional on Render as same-origin is automatic)
FRONTEND_URL=https://your-studiora-app.onrender.com
